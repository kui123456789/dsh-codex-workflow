{
  "name": "codex-workflow",
  "version": "2.0.0",
  "description": "Portable Agent Skill: Codex plans and reviews while the host agent implements.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kui123456789/dsh-codex-workflow.git"
  },
  "bin": {
    "codex-workflow": "scripts/workflow.mjs"
  },
  "files": [
    "SKILL.md",
    "agents",
    "references",
    "scripts/workflow.mjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "node scripts/run-tests.mjs",
    "verify": "pnpm typecheck && pnpm test",
    "doctor": "node scripts/workflow.mjs doctor",
    "doctor:offline": "node scripts/workflow.mjs doctor --offline",
    "pack:skill": "pnpm build && node scripts/package-skill.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify:isolated": "node scripts/verify-isolated.mjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "~0.28.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
